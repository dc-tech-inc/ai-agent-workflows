# Copy to .env to use a real model. Without a .env everything runs offline against the built-in fake provider.
# .env is git-ignored. Never commit a real key.

# fake (default) | anthropic | openai | gemini
LLM_PROVIDER=fake

# Needed only for a real provider. Use a key from your own account.
LLM_API_KEY=replace-with-your-key
# Model id from the provider's current model list. There is deliberately no default.
LLM_MODEL=replace-with-a-model-id
# Optional: another endpoint (an OpenAI-compatible server, a proxy, a local mock).
# LLM_BASE_URL=

# examples/mcp-client: the built entry point of dc-tech-inc/mcp-tool-server.
# MCP_TOOL_SERVER_DIST=/absolute/path/to/mcp-tool-server/dist/index.js
